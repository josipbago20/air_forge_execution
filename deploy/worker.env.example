# Production worker environment. Copy to /etc/airforge/worker.env, fill in the
# secrets, and `chmod 600`. Read by the systemd unit (EnvironmentFile).
#
# Tuned for a 2 GB / 1 vCPU droplet running 3 workers × 512 MB — enough for the
# pre-baked scientific stack (pandas/sklearn) on modest data. Scaling up later
# (e.g. 6 × 1g on an 8 GB / 4 vCPU droplet) is these two knobs plus the slice's
# MemoryMax — see the sizing table in DEPLOY.md.

# ── Backend ───────────────────────────────────────────────────────────────────
# Must be reachable FROM INSIDE the job containers (they call the /runtime API
# with the run token) — a public domain is fine; 127.0.0.1 is not (that is the
# container itself). CORS does not apply: workers and pipeline code are not
# browsers.
BACKEND_URL=https://api.airforge.net
# Must match the backend's WORKER_API_TOKEN exactly.
WORKER_API_TOKEN=change-me-to-the-backends-worker-token
# Leave unset for the shared Playground pool (serves every project's system
# queue). Set to a queue's UUID to make this fleet drain that one queue only —
# a dedicated deployment for a single project queue.
#WORKER_QUEUE_ID=

# ── Pool sizing ───────────────────────────────────────────────────────────────
# SIZING RULE: max_workers × WORKER_JOB_MEMORY ≤ airforge-jobs.slice MemoryMax
# ≤ droplet RAM − ~700 MB host headroom. Here: 3 × 512m = 1536M ≤ 1600M on a
# 2 GB box. Autoscale keeps the idle footprint at one worker process and grows
# with the queue; each worker process costs ~40–50 MB of host RAM when warm.
WORKER_AUTOSCALE=true
WORKER_MIN_WORKERS=1
WORKER_MAX_WORKERS=3

# ── Sandbox (untrusted user code) ─────────────────────────────────────────────
WORKER_SANDBOX=true
WORKER_CONTAINER_CMD=docker
WORKER_CONTAINER_RUNTIME=runsc
WORKER_JOB_IMAGE=airforge/job-base:latest
# Full internet for playground code (calls public APIs).
WORKER_CONTAINER_NETWORK=bridge
# Aggregate ceiling: every job/build container is placed under this slice.
WORKER_CONTAINER_CGROUP_PARENT=airforge-jobs.slice

# ── Per-run resource caps ─────────────────────────────────────────────────────
# 3 concurrent runs share ~0.9 of the single vCPU — CFS divides it fairly, so a
# CPU-heavy run at full concurrency gets ~0.3 core; size timeouts accordingly.
# The 512m includes gVisor's per-container overhead (~30–50 MB).
WORKER_JOB_MEMORY=512m
WORKER_JOB_CPUS=1
WORKER_JOB_PIDS_LIMIT=256

# ── Dependencies ──────────────────────────────────────────────────────────────
WORKER_REQUIREMENTS_FILENAME=requirements.txt
# Under StateDirectory=airforge ⇒ /var/lib/airforge. The uv wheel cache is a
# sibling (/var/lib/airforge/uv-cache), created automatically.
WORKER_DEPS_CACHE_DIR=/var/lib/airforge/deps
WORKER_DEP_INSTALL_TIMEOUT_SECONDS=600
WORKER_DEPS_CACHE_MAX_GB=20
