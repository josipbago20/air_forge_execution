# Where the AirForge backend runs.
BACKEND_URL=http://127.0.0.1:8001

# Must match WORKER_API_TOKEN in the backend's .env.
WORKER_API_TOKEN=dev-worker-token-change-me-4b8a17c2

# ── Pool sizing ───────────────────────────────────────────────────────────────
# Fixed number of warm workers (each is its own process; runs execute in
# parallel across them).
WORKER_POOL_SIZE=2

# Or let the pool breathe with queue depth instead:
WORKER_AUTOSCALE=false
WORKER_MIN_WORKERS=1
WORKER_MAX_WORKERS=8
# How long the queue must stay empty before one worker is retired.
WORKER_SCALE_DOWN_IDLE_SECONDS=90
